---
/*
 * The hero: four systems on a schematic grid with traffic running both ways,
 * requests along the top lane and replies along the bottom, and a ledger that
 * stays at zero difference. Inline SVG so it scales with its width on every
 * screen; colours come from the site's CSS variables so it follows the theme.
 *
 * Packets slide along a whole lane and pass under the middle chips (which are
 * opaque), so they read as going through each system. All motion is CSS and
 * stops under prefers-reduced-motion; the static picture still makes sense.
 */
const W = 720;
const H = 180;
const CHIP = { w: 112, h: 56, y: 48, r: 10 };
const LANE = { request: 66, reply: 86 };
const nodes = ["Client", "Gateway", "Switch", "Ledger"];
const xs = nodes.map((_, i) => Math.round((i * (W - CHIP.w)) / (nodes.length - 1)));
const laneStart = CHIP.w;
const laneEnd = xs[xs.length - 1];
const ledgerCenter = laneEnd + CHIP.w / 2;
const firstGap = (CHIP.w + xs[1]) / 2;
const packets = [0, 1, 2];
const mark = 12;
/** Packet length; a gradient makes it a comet, bright at the leading edge. */
const TAIL = 30;
---

<figure class="trip">
  <svg
    class="trip-svg"
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label="Requests travelling from a client through a gateway and a switch to a ledger, replies travelling back, and the ledger balanced at zero difference"
  >
    <defs>
      <pattern id="trip-grid" width="18" height="18" patternUnits="userSpaceOnUse">
        <circle cx="1" cy="1" r="1" class="trip-dot"></circle>
      </pattern>
      <filter id="trip-glow" x="-100%" y="-300%" width="300%" height="700%">
        <feGaussianBlur stdDeviation="3" result="blur"></feGaussianBlur>
        <feMerge>
          <feMergeNode in="blur"></feMergeNode>
          <feMergeNode in="SourceGraphic"></feMergeNode>
        </feMerge>
      </filter>
      {/* Comet tails: faint behind, bright at the leading edge. */}
      <linearGradient id="trip-tail">
        <stop offset="0" class="trip-tail-from"></stop>
        <stop offset="1" class="trip-tail-to"></stop>
      </linearGradient>
      <linearGradient id="trip-tail-reply" x1="1" x2="0">
        <stop offset="0" class="trip-tail-from"></stop>
        <stop offset="1" class="trip-tail-to"></stop>
      </linearGradient>
    </defs>

    <rect width={W} height={H} fill="url(#trip-grid)"></rect>
    <path
      class="trip-frame"
      d={`M0 ${mark}V0H${mark} M${W - mark} 0H${W}V${mark} M${W} ${H - mark}V${H}H${W - mark} M${mark} ${H}H0V${H - mark}`}
    ></path>

    <line class="trip-lane" x1={laneStart} y1={LANE.request} x2={laneEnd} y2={LANE.request}></line>
    <line class="trip-lane is-reply" x1={laneStart} y1={LANE.reply} x2={laneEnd} y2={LANE.reply}
    ></line>

    <g filter="url(#trip-glow)">
      {
        packets.map((p) => (
          <rect
            class="trip-packet"
            x={laneStart}
            y={LANE.request - 2}
            width={TAIL}
            height="4"
            rx="2"
            fill="url(#trip-tail)"
            style={`--p: ${p}; --dx: ${laneEnd - laneStart - TAIL}px`}
          />
        ))
      }
      {
        packets.map((p) => (
          <rect
            class="trip-packet is-reply"
            x={laneEnd - TAIL}
            y={LANE.reply - 2}
            width={TAIL}
            height="4"
            rx="2"
            fill="url(#trip-tail-reply)"
            style={`--p: ${p}; --dx: ${-(laneEnd - laneStart - TAIL)}px`}
          />
        ))
      }
    </g>

    {
      nodes.map((node, i) => (
        <g class="trip-chip" style={`--i: ${i}`}>
          <rect x={xs[i]} y={CHIP.y} width={CHIP.w} height={CHIP.h} rx={CHIP.r} />
          <circle class="trip-led" cx={xs[i] + CHIP.w - 11} cy={CHIP.y + 11} r="3" />
          <text x={xs[i] + CHIP.w / 2} y={CHIP.y + CHIP.h / 2 + 7}>
            {node}
          </text>
        </g>
      ))
    }

    <text class="trip-note" x={firstGap} y={LANE.request - 10}>request</text>
    <text class="trip-note" x={firstGap} y={LANE.reply + 20}>reply</text>

    <text class="trip-delta" x={ledgerCenter} y="134">Δ 0.00</text>
    <text class="trip-note" x={ledgerCenter} y="154">balanced</text>
  </svg>
</figure>
