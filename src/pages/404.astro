---
import BaseLayout from "../layouts/BaseLayout.astro";
import poetList from "../utils/poet.json";

const poem = poetList[Math.floor(Math.random() * poetList.length)];
---

<BaseLayout title="Page not found — Najmi" description="That page does not exist.">
  <div class="simple">
    <h1>This page doesn’t exist.</h1>
    <p class="lede">
      The link may be old or mistyped. Go to the <a href="/">homepage</a> or <a href="/#work"
        >see my work</a
      >.
    </p>
    <blockquote class="poem">{poem}</blockquote>
  </div>
</BaseLayout>
