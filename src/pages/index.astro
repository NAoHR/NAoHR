---
import { getCollection } from "astro:content";

import Route from "../components/Route.astro";
import SignalField from "../components/SignalField.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { now, projects, stack, work } from "../utils/content";
import { AVAILABILITY, LINKS } from "../utils/links";

const description =
  "Najmi (NAoHR) — software engineer specialising in backend development and system integration. Middleware, payment platforms and e-wallets in Java and Spring Boot.";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const dateFormat = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const heroLinks = LINKS.slice(0, 3);

/** "Seven engagements so far" reads better than a sentence opening on "7". */
const NUMBER_WORDS = ["Zero", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten", "Eleven", "Twelve"];
const spelled = (n: number) => NUMBER_WORDS[n] ?? String(n);
---

<BaseLayout title="Najmi — Backend & Integration Engineer" description={description}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: "Najmi",
      alternateName: "NAoHR",
      url: "https://naohr.site/",
      jobTitle: "Software Engineer",
      sameAs: [
        "https://github.com/NAoHR",
        "https://www.linkedin.com/in/najmi207",
        "https://www.codewars.com/users/Najmi",
      ],
    })}
  />

  <div class="first">
    <div class="backdrop" aria-hidden="true">
      <div class="backdrop-glow"></div>
      <div class="backdrop-grid"></div>
      <div class="backdrop-beams">
        <i style="top: 191px; --t: 7s; --d: 0s"></i>
        <i style="top: 383px; --t: 9s; --d: -3s"></i>
        <i style="top: 527px; --t: 8s; --d: -6s"></i>
        <i style="top: 719px; --t: 10s; --d: -2s"></i>
      </div>
      <div class="backdrop-grain"></div>
    </div>

    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-text">
        <a class="status" href={AVAILABILITY.href}>
          <span class="status-dot" aria-hidden="true"></span>
          <span>{AVAILABILITY.status}</span>
          <span class="status-where">{AVAILABILITY.where}</span>
        </a>
        <h1 id="hero-title">
          A message leaves one system, crosses three more, and still balances at the end.
        </h1>
        <div class="intro">
          <p>
            I’m Najmi, a backend and integration engineer at Indivara in Jakarta. I build that
            path in Java and Spring Boot: e-wallets, middleware and payment rails, and lately I
            lead the teams that build them.
          </p>
          <ul class="intro-links">
            {
              heroLinks.map(({ label, href }) => (
                <li>
                  {href.startsWith("mailto:") ? (
                    <a href={href}>{label}</a>
                  ) : (
                    <a href={href} target="_blank" rel="noopener noreferrer">
                      {label}
                    </a>
                  )}
                </li>
              ))
            }
            <li><a href="/cv.pdf">CV (PDF)</a></li>
          </ul>
        </div>
      </div>
      <div class="hero-art">
        <SignalField />
      </div>
    </section>

    <dl class="now">
      {
        now.map(({ label, text }) => (
          <div>
            <dt>{label}</dt>
            <dd>{text}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <section id="work" aria-labelledby="work-title">
    <h2 id="work-title">Work</h2>
    {
      work.map((employer) => (
        <div class="employer">
          <div class="row employer-head">
            <p class="when">{employer.period}</p>
            <div class="row-body">
              <h3>
                {employer.name}, {employer.place}
              </h3>
              <p class="employer-summary">
                {employer.summary} {spelled(employer.roles.length)}{" "}
                {employer.roles.length === 1 ? "engagement" : "engagements"} so far.
              </p>
              <ol class="ladder" aria-label={`Job titles at ${employer.name}`}>
                {employer.ladder.map(({ title, since }) => (
                  <li>
                    {title}
                    <span>{since}</span>
                  </li>
                ))}
              </ol>
            </div>
          </div>

          <ol class="rows">
            {employer.roles.map((role) => (
              <li class="row">
                <p class="when">{role.period}</p>
                <div class="row-body">
                  <h4>{role.headline}</h4>
                  <p class="subtitle">
                    {role.title}, {role.role}
                  </p>
                  <Route nodes={role.route} />
                  <p class="impact">{role.impact}</p>
                  <details>
                    <summary>
                      Details<span class="visually-hidden"> about {role.headline}</span>
                    </summary>
                    <p>{role.description}</p>
                    <ul>
                      {role.highlights.map((highlight) => (
                        <li>{highlight}</li>
                      ))}
                    </ul>
                    <p class="tech">{role.tag.join(", ")}</p>
                  </details>
                </div>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </section>

  <section id="projects" aria-labelledby="projects-title">
    <h2 id="projects-title">Side projects</h2>
    <ol class="rows">
      {
        projects.featured.map((project) => (
          <li class="row">
            <p class="when">
              {project.year}
              {project.note && `, ${project.note}`}
            </p>
            <div class="row-body">
              <h3>
                {project.link ? (
                  <a href={project.link} target="_blank" rel="noopener noreferrer">
                    {project.title}
                  </a>
                ) : (
                  project.title
                )}
              </h3>
              <Route nodes={project.route} />
              <p class="impact">{project.description}</p>
              <p class="tech">{project.tag.join(", ")}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="row earlier">
      <p class="when">Earlier</p>
      <ul class="row-body">
        {
          projects.earlier.map((project) => (
            <li>
              <a href={project.link} target="_blank" rel="noopener noreferrer">
                {project.title}
              </a>
              <span>{project.summary}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="stack" aria-labelledby="stack-title">
    <h2 id="stack-title">Tools</h2>
    <dl class="stack">
      {
        stack.map(({ group, items }) => (
          <div>
            <dt>{group}</dt>
            <dd>{items.join(", ")}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    posts.length > 0 && (
      <section id="writing" aria-labelledby="writing-title">
        <h2 id="writing-title">Writing</h2>
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              <time datetime={post.data.date.toISOString()}>
                {dateFormat.format(post.data.date)}
              </time>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
