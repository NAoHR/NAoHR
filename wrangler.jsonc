{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naohr",
  "compatibility_date": "2026-10-19",
  // Static site only: no Worker script, Cloudflare serves dist/ directly.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Requires the naohr.site zone to be active on this Cloudflare account.
  "routes": [{ "pattern": "naohr.site", "custom_domain": true }],
  "workers_dev": true
}
